{
  "name": "@valentinofish/vaultforge",
  "version": "0.2.0",
  "description": "LLM-powered personal knowledge base engine. Give it a topic — it researches, compiles, and maintains a full Markdown wiki for you. Built for Obsidian.",
  "type": "module",
  "bin": {
    "vaultforge": "./dist/index.js",
    "vf": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "tui",
    "knowledge-base",
    "wiki",
    "vault",
    "forge",
    "claude",
    "llm",
    "obsidian",
    "markdown",
    "research"
  ],
  "author": "makluganteng",
  "license": "MIT",
  "homepage": "https://github.com/makluganteng/vaultforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makluganteng/vaultforge.git"
  },
  "bugs": {
    "url": "https://github.com/makluganteng/vaultforge/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.3.0",
    "gray-matter": "^4.0.3",
    "ink": "^6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "nanoid": "^5.0.7",
    "ora": "^8.0.1",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^9.5.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
